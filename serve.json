      "type": 301
    },
    {
      "source": "/blog/category/uncategorized",
      "destination": "/blog/",
      "type": 301
    },
    {
      "source": "/blog/tag/guide",
      "destination": "/blog/category/support/",
      "type": 301
    },
    {
      "source": "/blog/tag/technical-support",
      "destination": "/blog/category/support/",
      "type": 301
    },
    {
      "source": "/blog/tag/soap-notes",
      "destination": "/blog/category/blog/",
      "type": 301
    },
    {
      "source": "/blog/tag/hipaa",
      "destination": "/blog/category/blog/",
      "type": 301
    },
    {
      "source": "/blog/tag/privacy",
      "destination": "/blog/category/blog/",
      "type": 301
    },
    {
      "source": "/blog/tag/ai",
      "destination": "/blog/category/blog/",
      "type": 301
    },
    {
      "source": "/blog/tag/artificial-intelligence",
      "destination": "/blog/category/blog/",
      "type": 301
    },
    {
      "source": "/blog/tag/automation",
      "destination": "/blog/category/blog/",
